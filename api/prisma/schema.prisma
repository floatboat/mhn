// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with authentication fields and relationships
model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String    @unique
  password    String
  active      Boolean   @default(true)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  roles         Role[]         @relation("UserRoles")
  apiKeys       ApiKey[]
  resetTokens   PasswdReset[]
  deployScripts DeployScript[]

  @@index([email])
  @@index([name])
}

// Role model for RBAC (Role-Based Access Control)
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // 'admin' or 'user'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users User[] @relation("UserRoles")

  @@index([name])
}

// API Key model for API authentication
model ApiKey {
  id        Int      @id @default(autoincrement())
  apiKey    String   @unique // UUID without dashes (32 chars)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())

  @@index([apiKey])
  @@index([userId])
}

// Password Reset model for password recovery flow
model PasswdReset {
  id        Int      @id @default(autoincrement())
  hashStr   String   @unique // Reset token (40 chars)
  active    Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime // Reset tokens expire after a certain time

  @@index([hashStr])
  @@index([userId])
  @@index([active])
}

// Deploy Script model (for future Phase 5)
model DeployScript {
  id        Int      @id @default(autoincrement())
  name      String // e.g., "Ubuntu - Dionaea"
  script    String   @db.Text // Shell script content (large text)
  notes     String   @db.Text
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Sensor model for honeypot instances (Phase 3 - Core MHN Functionality)
model Sensor {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique // UUID v1
  name       String
  hostname   String
  ip         String // Auto-detected from request
  identifier String   @unique // Same as UUID (for HPFeeds)
  honeypot   String // Type: dionaea, cowrie, conpot, etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  attacks           Attack[]
  hpfeedsCredential HPFeedsCredential?

  @@index([uuid])
  @@index([identifier])
  @@index([honeypot])
}

// HPFeeds credentials for sensor authentication
// Each sensor gets a unique secret for HPFeeds broker authentication
model HPFeedsCredential {
  id        Int      @id @default(autoincrement())
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  sensorId  Int      @unique
  uuid      String   @unique // Same as sensor UUID
  secret    String // 40-char hex secret
  channel   String // HPFeeds channel (e.g., "dionaea.capture")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uuid])
  @@index([channel])
}

// Attack metadata (stores summary info about attacks in PostgreSQL)
// Detailed attack data is stored in MongoDB
model Attack {
  id        Int      @id @default(autoincrement())
  sourceIp  String // Attacker IP address
  protocol  String // TCP, UDP, HTTP, etc.
  port      Int? // Target port (if applicable)
  timestamp DateTime @default(now()) // When attack occurred
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  sensorId  Int
  mongoId   String? // Reference to MongoDB ObjectId for detailed data
  country   String? // Geolocation: country code
  city      String? // Geolocation: city name
  latitude  Float? // Geolocation: latitude
  longitude Float? // Geolocation: longitude
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceIp])
  @@index([timestamp])
  @@index([sensorId])
  @@index([mongoId])
}

// Snort/Suricata IDS Rules
model Rule {
  id         Int      @id @default(autoincrement())
  message    String   // Human-readable rule description
  classtype  String   // Classification (e.g., "attempted-admin", "attempted-user")
  sid        Int      // Snort Rule ID (unique identifier)
  rev        Int      // Revision number (for versioning same rule)
  ruleFormat String   @db.Text // The actual rule text with placeholders
  isActive   Boolean  @default(true)
  notes      String?  @db.Text // Optional notes about the rule
  source     RuleSource? @relation(fields: [sourceId], references: [id])
  sourceId   Int?
  references Reference[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sid, rev])  // Only one version of each rule active
  @@index([sid])
  @@index([isActive])
  @@index([classtype])
}

// Rule references (CVE, URLs, etc.)
model Reference {
  id     Int    @id @default(autoincrement())
  text   String // CVE number, URL, or other reference
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId Int

  @@index([ruleId])
}

// Rule sources (where rules are downloaded from)
model RuleSource {
  id    Int     @id @default(autoincrement())
  name  String  @unique // e.g., "Snort Community Rules", "Emerging Threats"
  uri   String  // URL to download rules from
  note  String?
  rules Rule[]
  fetchJobs RuleFetchJob[] // Track fetch history
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Rule fetch job tracking (for scheduled/manual fetches)
model RuleFetchJob {
  id            Int      @id @default(autoincrement())
  source        RuleSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId      Int
  status        String   // 'pending', 'in_progress', 'success', 'failed', 'partial_success'
  rulesImported Int      @default(0)
  rulesFailed   Int      @default(0)
  rulesSkipped  Int      @default(0)
  errorMessage  String?  @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  lastAttempt   DateTime @default(now())
  attemptCount  Int      @default(0)
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceId])
  @@index([status])
  @@index([lastAttempt])
}

// Integration model for external system configurations
// Stores credentials and settings for Splunk, ArcSight, Elasticsearch, HPFeeds, Email
model Integration {
  id           Int      @id @default(autoincrement())
  type         String   // 'splunk', 'arcsight', 'elasticsearch', 'hpfeeds', 'email'
  name         String?  // User-friendly name for the integration
  config       Json     // Encrypted configuration (host, port, credentials, etc.)
  enabled      Boolean  @default(true)
  lastTestAt   DateTime? // Track when integration was last tested
  testStatus   String   @default("untested") // 'untested', 'success', 'failed'
  testMessage  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         IntegrationLog[]

  @@unique([type])  // Only one configuration per integration type
  @@index([type])
  @@index([enabled])
}

// Integration event log for tracking successful/failed forwards
model IntegrationLog {
  id            Int      @id @default(autoincrement())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId Int
  eventType     String   // 'attack', 'alert', 'stats', etc.
  status        String   // 'success', 'failed', 'retrying'
  eventData     Json?    // The data that was sent
  errorMessage  String?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
}

// Alert configuration and history
model Alert {
  id           Int      @id @default(autoincrement())
  type         String   // 'ddos', 'port_scan', 'high_severity', 'custom'
  name         String?
  description  String?
  enabled      Boolean  @default(true)

  // Alert trigger conditions
  threshold    Int      // Number of events to trigger alert
  timeWindow   Int      // Time window in seconds

  // Alert recipients and actions
  sendEmail    Boolean  @default(false)
  emailAddresses String? // Comma-separated email list or JSON array

  // History
  lastTriggeredAt DateTime?
  triggerCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([enabled])
}
