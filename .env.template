# MHN TypeScript Rewrite - Environment Configuration Template
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env with real secrets to version control!

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL primary database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://api_user:randompassword@postgres:5432/agave"

# MongoDB attack data database connection string
# Format: mongodb://user:password@host:port/database?authSource=admin
MONGODB_URI="mongodb://mongodb_user:mongodb_password@mongodb:27017/mhn?authSource=admin"

# Redis cache and job queue connection string
REDIS_URL="redis://redis:6379"

# ============================================================================
# Server Configuration
# ============================================================================

# Node.js environment (development, staging, production)
NODE_ENV="development"

# Server port (API runs on this port internally)
PORT=3000

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST="0.0.0.0"

# API base URL (used by frontend to call API)
# For development: http://localhost:3000 or http://localhost/api
# For production: https://your-domain.com/api
NEXT_PUBLIC_API_URL="http://localhost/api"

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT secret key for signing tokens (change in production!)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

# JWT token expiry time
JWT_EXPIRES_IN="7d"

# Sensor deployment key (change in production!)
# Used to authenticate sensor registration endpoint
# Generate with: openssl rand -hex 32
DEPLOY_KEY="your-deploy-key-change-in-production"

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (fatal, error, warn, info, debug, trace)
LOG_LEVEL="info"

# Fastify log level (same as LOG_LEVEL)
FASTIFY_LOG_LEVEL="debug"

# Pretty print logs in development (true/false)
PINO_PRETTY="true"

# ============================================================================
# Email Configuration (for password reset & alerts)
# ============================================================================

# Email provider: smtp, sendgrid, mailgun
EMAIL_PROVIDER="smtp"

# SMTP Configuration (if using SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@mhn.local"
SMTP_TLS="true"

# SendGrid Configuration (if using SendGrid)
# SENDGRID_API_KEY="your-sendgrid-api-key"
# SENDGRID_FROM="noreply@mhn.local"

# Mailgun Configuration (if using Mailgun)
# MAILGUN_API_KEY="your-mailgun-api-key"
# MAILGUN_DOMAIN="mhn.mailgun.org"
# MAILGUN_FROM="noreply@mhn.local"

# ============================================================================
# HPFeeds Broker Configuration
# ============================================================================

# HPFeeds broker host (external broker or localhost)
HPFEEDS_HOST="hpfeeds.example.com"

# HPFeeds broker port
HPFEEDS_PORT="10000"

# HPFeeds broker username (optional)
HPFEEDS_USERNAME="honeypot"

# HPFeeds broker password (optional)
HPFEEDS_PASSWORD="hpfeeds-password"

# ============================================================================
# Integration Configuration
# ============================================================================

# Splunk HEC (HTTP Event Collector) Configuration
# SPLUNK_HEC_URL="https://splunk.example.com:8088/services/collector"
# SPLUNK_HEC_TOKEN="your-hec-token"

# Elasticsearch Configuration
# ELASTICSEARCH_HOST="elasticsearch.example.com"
# ELASTICSEARCH_PORT="9200"
# ELASTICSEARCH_USERNAME="elastic"
# ELASTICSEARCH_PASSWORD="elastic-password"
# ELASTICSEARCH_INDEX_PREFIX="mhn-"

# ArcSight Configuration
# ARCSIGHT_HOST="arcsight.example.com"
# ARCSIGHT_PORT="514"
# ARCSIGHT_PROTOCOL="syslog"  # syslog or tcp

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins for CORS (comma-separated)
# For development: http://localhost:3000,http://localhost:3001
# For production: https://your-domain.com
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost"

# ============================================================================
# Feature Flags & Settings
# ============================================================================

# Enable demo/example plugins (set to false in production)
ENABLE_DEMO_PLUGINS="false"

# API rate limit (requests per second per IP)
RATE_LIMIT_RPS="10"

# Max request body size
MAX_BODY_SIZE="20mb"

# ============================================================================
# Docker Compose Specific (Development)
# ============================================================================

# Container restart policy
# RESTART_POLICY="unless-stopped"

# Docker network name
# DOCKER_NETWORK="mhn-network"

# ============================================================================
# Production-Specific Settings
# ============================================================================

# TLS/SSL certificate paths (for HTTPS)
# CERT_PATH="/etc/nginx/ssl/cert.pem"
# KEY_PATH="/etc/nginx/ssl/key.pem"

# Session secret (for secure cookies)
# SESSION_SECRET="your-session-secret-change-in-production"

# Trusted proxy (for X-Forwarded-* headers)
# TRUSTED_PROXY="nginx,127.0.0.1"

# Database connection pool size
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ============================================================================
# Monitoring & Observability (Optional - Future)
# ============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN="https://key@sentry.io/project"

# DataDog API key for metrics
# DATADOG_API_KEY="your-datadog-key"

# Prometheus metrics endpoint
# PROMETHEUS_ENABLED="false"

# ============================================================================
# Development Settings Only
# ============================================================================

# Enable hot reloading
# DEV_HOT_RELOAD="true"

# Mock external services (for testing without real integrations)
# MOCK_HPFEEDS="false"
# MOCK_EMAIL="false"
# MOCK_INTEGRATIONS="false"
